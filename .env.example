# Copy this file to .env and insert your MongoDB connection link
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management_db

# MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hospital_management_db?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management_db
PORT=5001
NODE_ENV=development
